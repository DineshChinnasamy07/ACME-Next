{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth":         { "ClusterId": "auth",         "Match": { "Path": "/auth/{**catch-all}" },         "Transforms": [ { "PathRemovePrefix": "/auth" } ] },
      "organization": { "ClusterId": "organization", "Match": { "Path": "/organization/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/organization" } ] },
      "masters":      { "ClusterId": "masters",      "Match": { "Path": "/masters/{**catch-all}" },      "Transforms": [ { "PathRemovePrefix": "/masters" } ] },
      "finance":      { "ClusterId": "finance",      "Match": { "Path": "/finance/{**catch-all}" },      "Transforms": [ { "PathRemovePrefix": "/finance" } ] },
      "budget":       { "ClusterId": "budget",       "Match": { "Path": "/budget/{**catch-all}" },       "Transforms": [ { "PathRemovePrefix": "/budget" } ] },
      "asset":        { "ClusterId": "asset",        "Match": { "Path": "/asset/{**catch-all}" },        "Transforms": [ { "PathRemovePrefix": "/asset" } ] },
      "payroll":      { "ClusterId": "payroll",      "Match": { "Path": "/payroll/{**catch-all}" },      "Transforms": [ { "PathRemovePrefix": "/payroll" } ] },
      "reports":      { "ClusterId": "reports",      "Match": { "Path": "/reports/{**catch-all}" },      "Transforms": [ { "PathRemovePrefix": "/reports" } ] },
      "system":       { "ClusterId": "system",       "Match": { "Path": "/system/{**catch-all}" },       "Transforms": [ { "PathRemovePrefix": "/system" } ] },
      "ticketing":    { "ClusterId": "ticketing",    "Match": { "Path": "/ticketing/{**catch-all}" },    "Transforms": [ { "PathRemovePrefix": "/ticketing" } ] }
    },
    "Clusters": {
      "auth":         { "Destinations": { "d1": { "Address": "https://localhost:7050/" } } },
      "organization": { "Destinations": { "d1": { "Address": "https://localhost:7051/" } } },
      "masters":      { "Destinations": { "d1": { "Address": "https://localhost:7052/" } } },
      "finance":      { "Destinations": { "d1": { "Address": "https://localhost:7053/" } } },
      "budget":       { "Destinations": { "d1": { "Address": "https://localhost:7054/" } } },
      "asset":        { "Destinations": { "d1": { "Address": "https://localhost:7055/" } } },
      "payroll":      { "Destinations": { "d1": { "Address": "https://localhost:7056/" } } },
      "reports":      { "Destinations": { "d1": { "Address": "https://localhost:7057/" } } },
      "system":       { "Destinations": { "d1": { "Address": "https://localhost:7058/" } } },
      "ticketing":    { "Destinations": { "d1": { "Address": "https://localhost:7059/" } } }
    }
  }
}
